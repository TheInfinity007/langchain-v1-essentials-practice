# @langchain/community declares @browserbasehq/stagehand as a *non-optional* peer
# dependency, and stagehand peer-depends on dotenv@^16, which conflicts with the
# dotenv@^17 this project uses. pnpm only warns about unmet peers; npm treats it
# as a hard ERESOLVE error. None of the notebooks use stagehand, so relaxing
# strict peer resolution is safe here.
legacy-peer-deps=true
