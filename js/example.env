# .env file used by load_dotenv to insert environment variables in the jupter environment
# copy example.env to .env

# Required for model usage
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required only if you use Gemini via Vertex AI (provider = "gemini").
# Auth comes from gcloud Application Default Credentials, so there is no API
# key -- but the project ID must be set explicitly, as it is NOT read from ADC.
# Region defaults to us-central1.
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here

# Optional: For evaluation and tracing
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lca-LangGraph-Essentials-V1